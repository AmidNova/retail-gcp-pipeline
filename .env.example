# Copy to .env (gitignored) and fill in. Read by docker compose, the Makefile
# and dbt (profiles.yml).

# --- GCP --------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-gcp-project-id-retail-raw
BQ_LOCATION=US
BQ_RAW_DATASET=retail_raw
# Local runs only (Makefile / dbt dev). Inside Airflow the key is mounted at
# /opt/airflow/include/gcp/service_account.json. Leave empty to use
# `gcloud auth application-default login` instead of a key file.
GCP_KEYFILE_PATH=

# --- Airflow ----------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_ADMIN_PASSWORD=change-me
# Generate with: make fernet-key
AIRFLOW__CORE__FERNET_KEY=

# Metabase admin account, used by `make metabase` to provision the dashboard.
MB_ADMIN_EMAIL=
MB_ADMIN_PASSWORD=
